{
  // Open Atmos from Setup.
  // `atmos` focuses a running instance over IPC, or launches one.
  "setup.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos",
    "when": "command -v atmos",
    "keywords": "atmos settings prefs appearance windows input security bar defaults idle",
    "description": "The window for themes, windows, input, security, and the rest of this machine"
  },
  "style.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos appearance",
    "when": "command -v atmos",
    "keywords": "settings prefs appearance theme font",
    "description": "Colors, wallpaper, type, and night light"
  },
  "style.font.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos appearance",
    "when": "command -v atmos",
    "keywords": "settings prefs appearance font family typeface",
    "description": "The monospace face and size the shell and terminals use"
  },
  "style.bar.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos bar",
    "when": "command -v atmos",
    "keywords": "settings prefs bar clock indicators agents",
    "description": "Where the bar sits, the clock, and its widgets"
  },
  "style.disks.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos disks",
    "when": "command -v atmos",
    "keywords": "settings prefs disks drive snapshot luks",
    "description": "Drive space, encryption, snapshots, and hibernation"
  },
  "style.sound.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos sound",
    "when": "command -v atmos",
    "keywords": "settings prefs sound audio volume mute microphone",
    "description": "Volume, devices, and a PipeWire restart if audio hangs"
  },
  "style.display.preferences": {
    "icon": "󰍹",
    "label": "Atmos",
    "action": "atmos display",
    "when": "command -v atmos",
    "keywords": "settings prefs display monitor scale brightness",
    "description": "Scale, brightness, and laptop input"
  },
  "style.bar.position.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos bar",
    "when": "command -v atmos",
    "keywords": "settings prefs bar position top bottom left right",
    "description": "Which edge of the screen the bar sits on"
  },
  "setup.applications": {
    "icon": "",
    "label": "Applications",
    "action": "atmos applications",
    "when": "command -v atmos",
    "keywords": "settings prefs applications desktop tui webapp remove uninstall",
    "description": "Remove desktop, terminal, and web launchers you added"
  },
  "setup.default.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos defaults",
    "when": "command -v atmos",
    "keywords": "settings prefs defaults browser terminal editor agent",
    "description": "The browser, terminal, editor, and coding agent Omarchy opens"
  },
  "setup.default.browser.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos defaults",
    "when": "command -v atmos",
    "keywords": "settings prefs browser chrome firefox chromium brave edge zen",
    "description": "The browser that opens links and web apps"
  },
  "setup.default.terminal.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos defaults",
    "when": "command -v atmos",
    "keywords": "settings prefs terminal alacritty foot ghostty kitty",
    "description": "The terminal other apps launch when they need a console"
  },
  "setup.default.editor.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos defaults",
    "when": "command -v atmos",
    "keywords": "settings prefs editor nvim neovim vscode code cursor zed sublime helix vim emacs",
    "description": "The editor Omarchy opens when you ask to edit a file"
  },
  "setup.default.agent.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos defaults",
    "when": "command -v atmos",
    "keywords": "settings prefs agent claude codex copilot crush gemini grok omp opencode pi",
    "description": "The coding agent Omarchy treats as the default"
  },
  "setup.network.preferences": {
    "icon": "",
    "label": "Atmos",
    "action": "atmos network",
    "when": "command -v atmos",
    "keywords": "settings prefs network dns bluetooth wifi band",
    "description": "What you are connected to, plus DNS, Wi-Fi, and Bluetooth"
  },
  "setup.network.dns.preferences": {
    "icon": "",
