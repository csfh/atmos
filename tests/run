#!/bin/bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

# No test may read or start the daemon of the session it runs in: a ratmos that
# finds a daemon answers from its samples instead of from the test's fixture.
SCRATCH=$(mktemp -d /tmp/atmos-tests-XXXXXX)
trap 'rm -rf "$SCRATCH"' EXIT
export XDG_RUNTIME_DIR="$SCRATCH" ATMOS_NO_AUTOSTART=1

if [[ ! -x node_modules/.bin/oxlint || ! -x node_modules/.bin/oxfmt ]]; then
  echo "not ok - npm install (oxlint/oxfmt missing)"
  exit 1
fi
./node_modules/.bin/oxlint services tests
echo "ok - oxlint"
./node_modules/.bin/oxfmt --check services tests
echo "ok - oxfmt --check"

for tool in file-budget partial-index-guard; do
  if [[ ! -x tests/$tool ]]; then
    echo "not ok - tests/$tool is not executable"
    exit 1
  fi
done
./tests/file-budget

if [[ ! -x .githooks/pre-commit ]]; then
  echo "not ok - .githooks/pre-commit is not executable"
  exit 1
fi
echo "ok - .githooks/pre-commit is executable"

remix_count=0
for remix_svg in icons/*.svg; do
  remix_count=$((remix_count + 1))
  if ! grep -q 'viewBox="0 0 24 24"' "$remix_svg"; then
    echo "not ok - remix icon $remix_svg"
    exit 1
  fi
done
if [[ $remix_count -lt 24 ]]; then
  echo "not ok - expected at least 24 remix icons, found $remix_count"
  exit 1
fi
echo "ok - remix line icons are present"

if ! command -v cargo >/dev/null 2>&1; then
  echo "not ok - cargo is required to build ratmos"
  exit 1
fi
for component in fmt clippy; do
  if ! cargo "$component" --version >/dev/null 2>&1; then
    echo "not ok - cargo $component is required (rustup component add $([[ $component == fmt ]] && echo rustfmt || echo clippy))"
    exit 1
  fi
done
cargo fmt --manifest-path backend/Cargo.toml --check
echo "ok - ratmos cargo fmt --check"
cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings
echo "ok - ratmos clippy"
cargo test --manifest-path backend/Cargo.toml
echo "ok - ratmos tests"

if [[ ! -x tests/frontend ]]; then
  echo "not ok - tests/frontend is not executable"
  exit 1
fi
./tests/frontend

shopt -s nullglob
for t in tests/*.test.js; do
  node "$t"
done
