#!/bin/bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

if [[ ! -x node_modules/.bin/oxlint || ! -x node_modules/.bin/oxfmt ]]; then
  echo "not ok - npm install (oxlint/oxfmt missing)"
  exit 1
fi
./node_modules/.bin/oxlint services tests
echo "ok - oxlint"
./node_modules/.bin/oxfmt --check services tests
echo "ok - oxfmt --check"

if [[ ! -x tests/compile-python ]]; then
  echo "not ok - tests/compile-python is not executable"
  exit 1
fi
./tests/compile-python
echo "ok - scripts/*.py compile"

if [[ ! -x .githooks/pre-commit ]]; then
  echo "not ok - .githooks/pre-commit is not executable"
  exit 1
fi
echo "ok - .githooks/pre-commit is executable"

remix_count=0
for remix_svg in icons/*.svg; do
  remix_count=$((remix_count + 1))
  if ! grep -q 'viewBox="0 0 24 24"' "$remix_svg"; then
    echo "not ok - remix icon $remix_svg"
    exit 1
  fi
done
if [[ $remix_count -lt 24 ]]; then
  echo "not ok - expected at least 24 remix icons, found $remix_count"
  exit 1
fi
echo "ok - remix line icons are present"

node tests/parse.test.js

catalog=$(mktemp)
snapshot=$(mktemp)
search_cache=$(mktemp -d)
export ATMOS_SEARCH_INDEX="$search_cache/search.sqlite"
cat >"$catalog" <<'JSON'
[
  {"id":"appearance/font","hub":"appearance","label":"Font","description":"The monospace face","hint":"omarchy font set","keywords":["theme"]},
  {"id":"network/wifi","hub":"network","label":"Wi-Fi","description":"Wireless radio","keywords":["ssid"]}
]
JSON
cat >"$snapshot" <<'JSON'
{"theme":"omarchy","barPosition":"top"}
JSON
font_hits=$(node services/SearchIndex.js query font --rows "$catalog")
font_upper=$(node services/SearchIndex.js query FONT --rows "$catalog")
network_hits=$(node services/SearchIndex.js query network --rows "$catalog")
theme_state=$(node services/SearchIndex.js state theme --snapshot "$snapshot")
echo "$font_hits" | node -e '
const hits = JSON.parse(require("fs").readFileSync(0, "utf8"))
if (!hits.some((row) => row.id === "appearance/font")) process.exit(1)
if (hits.some((row) => row.id === "network/wifi")) process.exit(1)
'
echo "$font_upper" | node -e '
const hits = JSON.parse(require("fs").readFileSync(0, "utf8"))
if (!hits.some((row) => row.id === "appearance/font")) process.exit(1)
'
echo "$network_hits" | node -e '
const hits = JSON.parse(require("fs").readFileSync(0, "utf8"))
if (hits.some((row) => row.id === "appearance/font")) process.exit(1)
'
if [[ $theme_state != '"omarchy"' ]]; then
  echo "not ok - SearchIndex.js state theme"
  rm -rf "$search_cache"
  rm -f "$catalog" "$snapshot"
  exit 1
fi
if [[ ! -f $ATMOS_SEARCH_INDEX ]]; then
  echo "not ok - SearchIndex.js did not write $ATMOS_SEARCH_INDEX"
  rm -rf "$search_cache"
  rm -f "$catalog" "$snapshot"
  exit 1
fi
echo "ok - SearchIndex.js query hits font and misses network"
echo "ok - SearchIndex.js state reads snapshot-derived theme"
echo "ok - SearchIndex.js writes the sqlite cache file"

serve_out=$(printf '%s\n' '{"query":"font"}' '{"query":"network"}' | node services/SearchIndex.js serve --rows "$catalog")
echo "$serve_out" | node -e '
const lines = require("fs").readFileSync(0, "utf8").trim().split("\n")
if (lines.length !== 2) process.exit(1)
const a = JSON.parse(lines[0])
const b = JSON.parse(lines[1])
if (a.query !== "font" || !a.hits.some((row) => row.id === "appearance/font")) process.exit(1)
if (b.query !== "network" || b.hits.some((row) => row.id === "appearance/font")) process.exit(1)
'
echo "ok - SearchIndex.js serve answers two queries on one process"

rm -rf "$search_cache"
rm -f "$catalog" "$snapshot"
unset ATMOS_SEARCH_INDEX

if command -v jq >/dev/null 2>&1; then
  paired_list=$'Device AA:BB:CC:DD:EE:FF Headphones\nDevice 11:22:33:44:55:66 Keyboard'
  connected_list='Device AA:BB:CC:DD:EE:FF Headphones'
  bt_jq='
    def parse:
      split("\n")
      | map(select(test("^Device ")))
      | map(capture("^Device (?<address>[0-9A-Fa-f:]{17})(?: (?<name>.*))?$")
        | {address: .address, name: ((.name // "") | if . == "" then .address else . end)});
    ([$connected | parse[] | .address] | unique) as $on
    | [$paired | parse[] as $d | $d + {connected: ($on | index($d.address) != null)}]
  '
  bt_json=$(jq -n -c --arg paired "$paired_list" --arg connected "$connected_list" "$bt_jq")
  echo "$bt_json" | jq -e '
    length == 2
    and ([.[] | select(.address == "AA:BB:CC:DD:EE:FF" and .name == "Headphones" and .connected == true)] | length == 1)
    and ([.[] | select(.address == "11:22:33:44:55:66" and .name == "Keyboard" and .connected == false)] | length == 1)
  ' >/dev/null
  echo "ok - bluetooth jq marks connected paired devices without aborting"

  if jq -n -c --arg paired "$paired_list" --arg connected "$connected_list" '
    def parse:
      split("\n")
      | map(select(test("^Device ")))
      | map(capture("^Device (?<address>[0-9A-Fa-f:]{17})(?: (?<name>.*))?$")
        | {address: .address, name: ((.name // "") | if . == "" then .address else . end)});
    ([$connected | parse[] | .address] | unique) as $on
    | [$paired | parse[] | . + {connected: ($on | index(.address) != null)}]
  ' >/dev/null 2>&1; then
    echo "not ok - broken bluetooth jq unexpectedly succeeded"
    exit 1
  fi
  echo "ok - broken bluetooth jq still aborts on paired devices"
else
  echo "ok - skipping bluetooth jq (jq not available)"
fi

if [[ -f scripts/snapshot.sh ]]; then
  if ! grep -q 'parse\[\] as \$d | \$d + {connected: (\$on | index(\$d.address) != null)}' scripts/snapshot.sh; then
    echo "not ok - snapshot.sh bluetooth jq still indexes .address against \$on"
    exit 1
  fi
  echo "ok - snapshot.sh bluetooth jq binds each paired device before index()"

  text_size_guards=$(grep -cE 'omarchy display text size .*\| awk .* \|\| true' scripts/snapshot.sh || true)
  if [[ $text_size_guards -lt 2 ]]; then
    echo "not ok - text_size probe missing a || true guard"
    exit 1
  fi
  if ! grep -qE 'omarchy brightness display --no-osd --monitor .* \|\| true' scripts/snapshot.sh; then
    echo "not ok - brightness probe is unguarded"
    exit 1
  fi
  if ! grep -qE 'nmcli -e no -g DEVICE,TYPE,STATE device status .* \|\| true' scripts/snapshot.sh; then
    echo "not ok - wifi_iface probe is unguarded"
    exit 1
  fi
  if ! grep -A3 'timedatectl list-timezones' scripts/snapshot.sh | grep -q '|| true'; then
    echo "not ok - timezones probe is unguarded"
    exit 1
  fi
  echo "ok - snapshot.sh best-effort probes are guarded with || true"

  set -euo pipefail
  guarded=$(false | awk 'NR==1 { print $1; exit }' || true)
  [[ -z $guarded ]]
  echo "ok - guarded failing probe does not abort under set -euo pipefail"
fi

if [[ -x scripts/snapshot.sh ]] && command -v omarchy >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  look_json=$(bash scripts/snapshot.sh look)
  echo "$look_json" | jq -e '.theme and (.themes | type == "array") and has("font") and has("nightlight") and has("barPosition") and has("hyprLook") and has("idleScreensaver") and has("monitors")' >/dev/null
  if echo "$look_json" | jq -e 'has("hardware") or has("disks")' >/dev/null; then
    echo "not ok - snapshot.sh look includes hardware or disks"
    exit 1
  fi
  echo "ok - snapshot.sh look emits theme/font without hardware inventory"
  rest_json=$(bash scripts/snapshot.sh rest)
  echo "$rest_json" | jq -e 'has("hardware") and has("disks") and has("barPosition")' >/dev/null
  if echo "$rest_json" | jq -e 'has("theme") or has("themes") or has("font") or has("plymouth")' >/dev/null; then
    echo "not ok - snapshot.sh rest includes look fields"
    exit 1
  fi
  echo "ok - snapshot.sh rest emits hardware without theme lists"
  json=$(bash scripts/snapshot.sh)
  echo "$json" | jq -e '.theme and .themes and has("extraThemes") and (.extraThemes | type == "array") and has("desktopApps") and (.desktopApps | type == "array") and has("tuiApps") and (.tuiApps | type == "array") and has("webApps") and (.webApps | type == "array") and .barPosition and .idleScreensaver and has("stayAwake") and has("nightlight") and has("nightlightTemperature") and has("screensaverEnabled") and has("barVisible") and has("dns") and has("bluetooth") and has("suspendEnabled") and has("powerProfile") and has("powerProfileAc") and has("powerProfileBattery") and (.powerProfiles | type == "array") and has("crashCapture") and has("plymouth") and (.plymouthThemes | type == "array") and has("doNotDisturb") and has("weatherLocation") and has("weatherCoords") and has("weatherAuto") and has("weatherPresent") and has("weatherUnit") and has("weatherRefreshMinutes") and has("reminderCount") and has("reminderActive") and has("reminders") and (.reminders | type == "array") and has("clockFormat") and has("clockFormatAlt") and has("clockWeekStart") and has("clockPresent") and has("clockBirthYear") and has("clockLifeExpectancy") and has("indicatorsPresent") and has("indicatorsAlwaysShow") and has("indicatorsItems") and (.indicatorsItems | type == "array") and has("agentsPresent") and has("agentsRefreshIntervalSec") and has("agentsSync") and has("agentsSyncDir") and has("agentsSyncFileName") and has("agentsSyncDeviceId") and has("spacerPresent") and has("spacerSize") and has("trayPresent") and has("trayHidden") and (.trayHidden | type == "array") and has("trayPinned") and (.trayPinned | type == "array") and has("powerPresent") and has("powerShowPercentage") and has("isLaptop") and has("batteryPresent") and has("monitors") and (.monitors | type == "array") and has("internalPresent") and has("internalEnabled") and has("externalPresent") and has("mirroring") and has("touchpadPresent") and has("touchpadEnabled") and has("touchscreenPresent") and has("touchscreenEnabled") and has("keyboardBacklightPresent") and has("keyboardBrightness") and has("wifiConnected") and has("wifiBandSelected") and (.wifiBands | type == "array") and has("wifiIface") and has("netKind") and has("netIface") and has("netIp") and has("wifiHw") and has("wifiRadio") and has("wifiConnections") and (.wifiConnections | type == "array") and has("bluetoothDevices") and (.bluetoothDevices | type == "array") and has("audioSinks") and (.audioSinks | type == "array") and has("audioSources") and (.audioSources | type == "array") and has("audioOutputVolume") and has("audioOutputMuted") and has("audioInputVolume") and has("audioInputMuted") and has("audioTuningMatch") and has("audioTuningOn") and has("disks") and (.disks | type == "array") and has("hardware") and (.hardware | type == "object") and has("luksDevices") and (.luksDevices | type == "array") and has("swapDevices") and (.swapDevices | type == "array") and has("snapperPresent") and has("snapperConfigs") and (.snapperConfigs | type == "array") and has("snapshots") and (.snapshots | type == "array") and has("hibernationAvailable") and has("hibernationSupported") and has("hibernationConfigured") and has("screensaverBranded") and has("aboutBranded") and has("timezone") and has("timezones") and (.timezones | type == "array") and has("hostname") and has("keyboardLayout") and has("keyboardLayouts") and (.keyboardLayouts | type == "array") and has("ntp") and has("ntpAvailable") and has("ntpSynchronized") and has("locale") and has("locales") and (.locales | type == "array") and has("parallelDownloads") and has("fullName") and has("currentUser") and has("avatarPath") and has("users") and (.users | type == "array") and has("groups") and (.groups | type == "array") and has("hyprLook") and has("hyprInput") and has("hyprLookManaged") and has("hyprNoGaps") and has("fingerprintAvailable") and has("sshdEnabled") and has("omarchyChannel") and has("updateAvailable") and has("plugins") and (.plugins | type == "array") and has("voxtypeInstalled") and has("fstrimEnabled") and has("directBootAvailable") and has("mimePdf") and has("picturesDir") and has("videosDir") and has("recordingActive") and has("webcamOverlay") and has("services") and has("gaming") and has("extras") and has("hooks") and (.hooks | type == "array") and has("autostart") and (.autostart | type == "array") and has("autostartManaged") and has("nightlightDay") and has("nightlightNight") and has("nightlightNightOn") and has("tailscalePeers") and (.tailscalePeers | type == "array") and (.hyprLook | has("cursorSize")) and (.hyprLook | has("activeOpacity")) and has("bindings") and (.bindings | type == "array") and has("bindingsManaged") and has("windowRules") and (.windowRules | type == "array") and has("windowRulesManaged") and has("keybindings") and (.keybindings | type == "array") and has("focusedClass") and has("cupsActive") and has("printerSetup") and has("hwNvidia") and has("hwVulkan") and has("hwIntel") and has("dmiProduct") and has("cpuStat") and has("memoryStat") and has("cpuIdentity") and has("gpuIdentity") and has("npuIdentity") and has("atmosRevision") and has("atmosChannel") and has("atmosInstalled")' >/dev/null
  echo "ok - snapshot.sh emits a usable JSON object"
else
  echo "ok - skipping live snapshot (omarchy/jq not available)"
fi

if [[ -x scripts/set-bar-widget.sh ]] && command -v omarchy-shell-config >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  widget_home=$(mktemp -d)
  mkdir -p "$widget_home/.config/omarchy"
  cat >"$widget_home/.config/omarchy/shell.json" <<'JSON'
{
  "version": 1,
  "bar": {
    "layout": {
      "left": [],
      "center": [{ "id": "omarchy.indicators" }],
      "right": ["omarchy.tray"]
    }
  },
  "plugins": []
}
JSON
  HOME="$widget_home" bash scripts/set-bar-widget.sh omarchy.indicators items '["Dnd","NightLight"]'
  HOME="$widget_home" bash scripts/set-bar-widget.sh omarchy.tray hidden '["app.one"]'
  jq -e '
    .bar.layout.center[0].items == ["Dnd","NightLight"] and
    .bar.layout.right[0].id == "omarchy.tray" and
    .bar.layout.right[0].hidden == ["app.one"]
  ' "$widget_home/.config/omarchy/shell.json" >/dev/null
  rm -rf "$widget_home"
  echo "ok - set-bar-widget.sh writes JSON array widget settings"
else
  echo "ok - skipping set-bar-widget.sh (omarchy-shell-config/jq not available)"
fi

if [[ -x scripts/set-wifi-connection.sh ]]; then
  if bash scripts/set-wifi-connection.sh radio maybe >/dev/null 2>&1; then
    echo "not ok - set-wifi-connection.sh accepted a bad radio value"
    exit 1
  fi
  if bash scripts/set-wifi-connection.sh up not-a-uuid >/dev/null 2>&1; then
    echo "not ok - set-wifi-connection.sh accepted a bad uuid"
    exit 1
  fi
  echo "ok - set-wifi-connection.sh rejects bad radio and uuid values"
else
  echo "ok - skipping set-wifi-connection.sh"
fi

if [[ -x scripts/set-audio.sh ]]; then
  if bash scripts/set-audio.sh output-volume 101 >/dev/null 2>&1; then
    echo "not ok - set-audio.sh accepted a volume over 100"
    exit 1
  fi
  echo "ok - set-audio.sh rejects an out-of-range volume"
else
  echo "ok - skipping set-audio.sh"
fi

if [[ -x scripts/list-apps.py ]] && command -v python3 >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  apps_home=$(mktemp -d)
  mkdir -p "$apps_home/.local/share/applications"
  cat >"$apps_home/.local/share/applications/HEY.desktop" <<'EOF'
[Desktop Entry]
Name=HEY
Exec=omarchy-launch-webapp https://hey.com
Type=Application
EOF
  cat >"$apps_home/.local/share/applications/Btop.desktop" <<'EOF'
[Desktop Entry]
Name=Btop
Exec=xdg-terminal-exec --app-id=TUI.float -e btop
Type=Application
EOF
  cat >"$apps_home/.local/share/applications/Notes.desktop" <<'EOF'
[Desktop Entry]
Name=Notes
Exec=notes
Type=Application
EOF
  HOME="$apps_home" XDG_DATA_HOME="$apps_home/.local/share" python3 scripts/list-apps.py | jq -e '
    (.web | map(.name) | index("HEY") != null) and
    (.tui | map(.name) | index("Btop") != null) and
    (.desktop | map(.name) | index("Notes") != null)
  ' >/dev/null
  rm -rf "$apps_home"
  echo "ok - list-apps.py classifies desktop, TUI, and web launchers"
else
  echo "ok - skipping list-apps.py"
fi

if [[ -x scripts/add-desktop-launcher.sh ]]; then
  launcher_home=$(mktemp -d)
  mkdir -p "$launcher_home/.local/share/applications"
  if HOME="$launcher_home" XDG_DATA_HOME="$launcher_home/.local/share" bash scripts/add-desktop-launcher.sh 'foo/bar' notes; then
    echo "not ok - add-desktop-launcher.sh accepted a slash in the name"
    rm -rf "$launcher_home"
    exit 1
  fi
  HOME="$launcher_home" XDG_DATA_HOME="$launcher_home/.local/share" bash scripts/add-desktop-launcher.sh Notes notes application-x-executable
  grep -q '^Name=Notes$' "$launcher_home/.local/share/applications/Notes.desktop"
  grep -q '^Exec=notes$' "$launcher_home/.local/share/applications/Notes.desktop"
  rm -rf "$launcher_home"
  echo "ok - add-desktop-launcher.sh writes a desktop file and rejects a slash"
else
  echo "ok - skipping add-desktop-launcher.sh"
fi

if [[ -x scripts/disk-inventory.py ]] && command -v python3 >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  python3 scripts/disk-inventory.py | jq -e '(.disks | type == "array") and (.luksDevices | type == "array") and (.swapDevices | type == "array") and (.snapshots | type == "array")' >/dev/null
  echo "ok - disk-inventory.py emits disks, luksDevices, swapDevices, and snapshots"
else
  echo "ok - skipping disk-inventory.py"
fi

if [[ -x scripts/hw-inventory.py ]] && command -v python3 >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  python3 scripts/hw-inventory.py | jq -e '
    (.cpu | type == "object") and (.memory | type == "object") and
    (.chipset | type == "object") and (.machine | type == "object") and
    (.board | type == "object") and (.bios | type == "object") and
    (.gpus | type == "array") and (.npus | type == "array") and (.nics | type == "array") and
    (.audio | type == "array") and (.usb | type == "array") and
    (.batteries | type == "array") and (.thermals | type == "array") and
    (.memory.modules | type == "array") and has("tpm") and has("secureBoot") and has("virtualization")
  ' >/dev/null
  echo "ok - hw-inventory.py emits cpu, memory, chipset, and the other units"
else
  echo "ok - skipping hw-inventory.py"
fi

if [[ -x scripts/set-keyboard-layout.sh ]]; then
  if bash scripts/set-keyboard-layout.sh --bad >/dev/null 2>&1; then
    echo "not ok - set-keyboard-layout.sh accepted a flag"
    exit 1
  fi
  if bash scripts/set-keyboard-layout.sh US >/dev/null 2>&1; then
    echo "not ok - set-keyboard-layout.sh accepted uppercase"
    exit 1
  fi
  if bash scripts/set-keyboard-layout.sh zz >/dev/null 2>&1; then
    echo "not ok - set-keyboard-layout.sh accepted an unknown layout"
    exit 1
  fi
  echo "ok - set-keyboard-layout.sh rejects bad layout ids"
else
  echo "ok - skipping set-keyboard-layout.sh"
fi

if [[ -x scripts/list-accounts.py ]] && command -v python3 >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  python3 scripts/list-accounts.py | jq --arg u "$(id -un)" -e '
    has("currentUser") and has("avatarPath") and (.users | type == "array") and (.groups | type == "array")
    and .currentUser == $u
    and ([.users[] | select(.name == $u and .current == true)] | length == 1)
  ' >/dev/null
  echo "ok - list-accounts.py emits currentUser, users, and groups"
else
  echo "ok - skipping list-accounts.py"
fi

if [[ -x scripts/set-avatar.sh ]]; then
  if bash scripts/set-avatar.sh set root /tmp/face.png >/dev/null 2>&1; then
    echo "not ok - set-avatar.sh accepted root"
    exit 1
  fi
  if bash scripts/set-avatar.sh set hallas- /tmp/face.png >/dev/null 2>&1; then
    echo "not ok - set-avatar.sh accepted a trailing hyphen"
    exit 1
  fi
  if bash scripts/set-avatar.sh set "$(id -un)" ../evil.png >/dev/null 2>&1; then
    echo "not ok - set-avatar.sh accepted a relative path"
    exit 1
  fi
  if bash scripts/set-avatar.sh set "$(id -un)" /etc/passwd >/dev/null 2>&1; then
    echo "not ok - set-avatar.sh accepted a non-image"
    exit 1
  fi
  echo "ok - set-avatar.sh rejects root, a trailing hyphen, a relative path, and a non-image"
else
  echo "ok - skipping set-avatar.sh"
fi

if [[ -x scripts/manage-account.sh ]]; then
  if bash scripts/manage-account.sh add-user root Name false >/dev/null 2>&1; then
    echo "not ok - manage-account.sh accepted root"
    exit 1
  fi
  if bash scripts/manage-account.sh add-user hallas- Name false >/dev/null 2>&1; then
    echo "not ok - manage-account.sh accepted a trailing hyphen"
    exit 1
  fi
  if bash scripts/manage-account.sh add-user Bad Name false >/dev/null 2>&1; then
    echo "not ok - manage-account.sh accepted uppercase"
    exit 1
  fi
  if printf '' | bash scripts/manage-account.sh add-user validname Name false >/dev/null 2>&1; then
    echo "not ok - manage-account.sh accepted an empty password"
    exit 1
  fi
  if bash scripts/manage-account.sh remove-user "$(id -un)" >/dev/null 2>&1; then
    echo "not ok - manage-account.sh accepted removing the session user"
    exit 1
  fi
  if bash scripts/manage-account.sh remove-group wheel >/dev/null 2>&1; then
    echo "not ok - manage-account.sh accepted removing wheel"
    exit 1
  fi
  if bash scripts/manage-account.sh add-group root >/dev/null 2>&1; then
    echo "not ok - manage-account.sh accepted adding root"
    exit 1
  fi
  if bash scripts/manage-account.sh set-member wheel "$(id -un)" off >/dev/null 2>&1; then
    echo "not ok - manage-account.sh accepted dropping the session user from wheel"
    exit 1
  fi
  echo "ok - manage-account.sh rejects reserved names, empty passwords, and unsafe removes"
else
  echo "ok - skipping manage-account.sh"
fi

if [[ -x scripts/set-full-name.sh ]]; then
  if bash scripts/set-full-name.sh --bad >/dev/null 2>&1; then
    echo "not ok - set-full-name.sh accepted a flag"
    exit 1
  fi
  if bash scripts/set-full-name.sh 'bad:name' >/dev/null 2>&1; then
    echo "not ok - set-full-name.sh accepted a colon"
    exit 1
  fi
  if bash scripts/set-full-name.sh 'Last, First' >/dev/null 2>&1; then
    echo "not ok - set-full-name.sh accepted a comma"
    exit 1
  fi
  echo "ok - set-full-name.sh rejects bad names"
else
  echo "ok - skipping set-full-name.sh"
fi

if [[ -x scripts/set-hostname.sh ]]; then
  if bash scripts/set-hostname.sh --bad >/dev/null 2>&1; then
    echo "not ok - set-hostname.sh accepted a flag"
    exit 1
  fi
  if bash scripts/set-hostname.sh 'has space' >/dev/null 2>&1; then
    echo "not ok - set-hostname.sh accepted a space"
    exit 1
  fi
  if bash scripts/set-hostname.sh 'bad-.name' >/dev/null 2>&1; then
    echo "not ok - set-hostname.sh accepted a trailing hyphen in a label"
    exit 1
  fi
  echo "ok - set-hostname.sh rejects bad hostnames"
else
  echo "ok - skipping set-hostname.sh"
fi

if [[ -x scripts/set-parallel-downloads.sh ]]; then
  if bash scripts/set-parallel-downloads.sh 0 >/dev/null 2>&1; then
    echo "not ok - set-parallel-downloads.sh accepted 0"
    exit 1
  fi
  if bash scripts/set-parallel-downloads.sh 21 >/dev/null 2>&1; then
    echo "not ok - set-parallel-downloads.sh accepted 21"
    exit 1
  fi
  if bash scripts/set-parallel-downloads.sh --5 >/dev/null 2>&1; then
    echo "not ok - set-parallel-downloads.sh accepted a flag"
    exit 1
  fi
