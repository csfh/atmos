if [[ -x scripts/update-atmos.sh ]]; then
  if bash scripts/update-atmos.sh --bad >/dev/null 2>&1; then
    echo "not ok - update-atmos.sh accepted a flag"
    exit 1
  fi
  if bash scripts/update-atmos.sh >/dev/null 2>&1; then
    echo "not ok - update-atmos.sh accepted no action"
    exit 1
  fi
  echo "ok - update-atmos.sh rejects a bad action"
else
  echo "ok - skipping update-atmos.sh"
fi

if [[ -x bin/atmos ]]; then
  link_home=$(mktemp -d)
  ln -sfn "$ROOT/bin/atmos" "$link_home/atmos"
  got=$(ATMOS_PRINT_ROOT=1 "$link_home/atmos")
  if [[ $got != "$ROOT" ]]; then
    echo "not ok - bin/atmos symlink resolved to $got"
    rm -rf "$link_home"
    exit 1
  fi
  rm -rf "$link_home"
  echo "ok - bin/atmos follows a symlink to the app root"
else
  echo "ok - skipping bin/atmos symlink root"
fi

if [[ -f scripts/atmos-xdg.sh ]] && command -v python3 >/dev/null 2>&1; then
  menu_home=$(mktemp -d)
  mkdir -p "$menu_home/.config/omarchy/extensions"
  cat >"$menu_home/.config/omarchy/extensions/omarchy-menu.jsonc" <<'JSON'
{
  "setup.preferences": {
    "label": "Atmos",
    "action": "atmos"
  },
  "keep.me": {
    "label": "Stay",
    "action": "true"
  }
}
JSON
  # shellcheck source=../scripts/atmos-xdg.sh
  . "$ROOT/scripts/atmos-xdg.sh"
  HOME="$menu_home" atmos_strip_omarchy_menu
  if grep -q '"setup.preferences"' "$menu_home/.config/omarchy/extensions/omarchy-menu.jsonc"; then
    echo "not ok - atmos_strip_omarchy_menu left an Atmos menu entry"
    rm -rf "$menu_home"
    exit 1
  fi
  grep -q '"keep.me"' "$menu_home/.config/omarchy/extensions/omarchy-menu.jsonc"
  desktop_home=$(mktemp -d)
  mkdir -p "$desktop_home/bin" "$desktop_home/packaging"
  cp "$ROOT/packaging/atmos.desktop" "$desktop_home/packaging/atmos.desktop"
  printf '#!/bin/bash\n' >"$desktop_home/bin/atmos"
  chmod +x "$desktop_home/bin/atmos"
  atmos_write_desktop "$desktop_home" "$desktop_home/atmos.desktop"
  grep -q "^Exec=$desktop_home/bin/atmos$" "$desktop_home/atmos.desktop"
  grep -q "^TryExec=$desktop_home/bin/atmos$" "$desktop_home/atmos.desktop"
  link_bin=$(mktemp -d)
  mkdir -p "$link_bin/.local/bin"
  printf '#!/bin/bash\necho staged\n' >"$desktop_home/bin/atmos"
  chmod +x "$desktop_home/bin/atmos"
  ln -sfn "$desktop_home/bin/atmos" "$link_bin/.local/bin/atmos"
  HOME="$link_bin" XDG_BIN_HOME="$link_bin/.local/bin" atmos_write_bin_wrapper "$desktop_home"
  grep -q 'echo staged' "$desktop_home/bin/atmos"
  grep -q "exec \"$desktop_home/bin/atmos\"" "$link_bin/.local/bin/atmos"
  if [[ -L $link_bin/.local/bin/atmos ]]; then
    echo "not ok - atmos_write_bin_wrapper left a symlink in bin"
    rm -rf "$menu_home" "$desktop_home" "$link_bin"
    exit 1
  fi
  rm -rf "$menu_home" "$desktop_home" "$link_bin"
  echo "ok - atmos-xdg strips menu entries and writes an absolute desktop Exec"
else
  echo "ok - skipping atmos_strip_omarchy_menu"
fi

if [[ -x scripts/set-atmos-channel.sh ]]; then
  if bash scripts/set-atmos-channel.sh main >/dev/null 2>&1; then
