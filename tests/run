-- atmos:windows begin
o.window("^Emulator$", { float = true })
-- atmos:windows end
LUA
  cat >"$reset_home/hyprland.lua" <<'LUA'
require("hypr.autostart")
require("default.hypr.toggles")
LUA
  mkdir -p "$reset_home/cache"
  : >"$reset_home/cache/search.sqlite"
  : >"$reset_home/cache/search.sqlite-wal"
  : >"$reset_home/cache/search.sqlite-shm"
  : >"$reset_home/cache/search.sqlite-journal"
  ATMOS_LOOK_FILE="$reset_home/looknfeel.lua" \
    ATMOS_INPUT_FILE="$reset_home/input.lua" \
    ATMOS_AUTOSTART_FILE="$reset_home/autostart.lua" \
    ATMOS_BINDINGS_FILE="$reset_home/bindings.lua" \
    ATMOS_WINDOWS_FILE="$reset_home/atmos.lua" \
    ATMOS_HYPRLAND_FILE="$reset_home/hyprland.lua" \
    ATMOS_SEARCH_INDEX="$reset_home/cache/search.sqlite" \
    ATMOS_SKIP_HYPR=1 \
    bash scripts/reset-atmos.sh
  grep -q -- '-- keep this comment' "$reset_home/looknfeel.lua"
  if grep -q -- '-- atmos:look begin' "$reset_home/looknfeel.lua"; then
    echo "not ok - reset-atmos.sh left the look sentinel"
    rm -rf "$reset_home"
    exit 1
  fi
  grep -q -- '-- user note' "$reset_home/input.lua"
  if grep -q -- '-- atmos:input begin' "$reset_home/input.lua"; then
    echo "not ok - reset-atmos.sh left the input sentinel"
    rm -rf "$reset_home"
    exit 1
  fi
  grep -q 'o.launch_on_start("waybar")' "$reset_home/autostart.lua"
  if grep -q -- '-- atmos:autostart begin' "$reset_home/autostart.lua"; then
    echo "not ok - reset-atmos.sh left the autostart sentinel"
    rm -rf "$reset_home"
    exit 1
  fi
  grep -q 'o.bind("SUPER + D"' "$reset_home/bindings.lua"
  if grep -q -- '-- atmos:bindings begin' "$reset_home/bindings.lua"; then
    echo "not ok - reset-atmos.sh left the bindings sentinel"
    rm -rf "$reset_home"
    exit 1
  fi
  grep -q 'o.window("dev.csfh.atmos", { float = true })' "$reset_home/atmos.lua"
  if grep -q -- '-- atmos:windows begin' "$reset_home/atmos.lua"; then
    echo "not ok - reset-atmos.sh left the windows sentinel"
    rm -rf "$reset_home"
    exit 1
  fi
  grep -q 'require("hypr.atmos")' "$reset_home/hyprland.lua"
  if [[ -e $reset_home/cache/search.sqlite || -e $reset_home/cache/search.sqlite-wal || -e $reset_home/cache/search.sqlite-shm || -e $reset_home/cache/search.sqlite-journal ]]; then
    echo "not ok - reset-atmos.sh left the search index"
    rm -rf "$reset_home"
    exit 1
  fi
  rm -rf "$reset_home"
  echo "ok - reset-atmos.sh strips sentinels, drops the search index, and keeps the Atmos window seed"
else
  echo "ok - skipping reset-atmos.sh"
fi

