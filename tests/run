  fi
  if bash scripts/set-atmos-channel.sh --alpha >/dev/null 2>&1; then
    echo "not ok - set-atmos-channel.sh accepted a flag"
    exit 1
  fi
  echo "ok - set-atmos-channel.sh rejects a bad channel"
else
  echo "ok - skipping set-atmos-channel.sh"
fi
