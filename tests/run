  if bash scripts/reset-atmos.sh --bad >/dev/null 2>&1; then
    echo "not ok - reset-atmos.sh accepted a flag"
    exit 1
  fi
  reset_home=$(mktemp -d)
  cat >"$reset_home/looknfeel.lua" <<'LUA'
